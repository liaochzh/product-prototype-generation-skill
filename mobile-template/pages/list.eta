<div class="min-h-full bg-neutral-50 pb-28">
  <header class="sticky top-0 z-10 px-page pt-14 pb-3 bg-neutral-50/80 backdrop-blur-xl">
    <p class="eyebrow text-brand-600"><%= it.meta.productName %></p>
    <h2 class="page-title mt-1 text-neutral-900"><%= it.copy.list.title %></h2>
    <div class="mt-3 flex gap-2">
      <div class="flex flex-1 items-center gap-2 rounded-2xl bg-white px-3.5 h-11 shadow-sm ring-1 ring-neutral-200/70">
        <i data-lucide="search" class="text-neutral-400 text-lg"></i>
        <input class="flex-1 bg-transparent text-sm outline-none placeholder:text-neutral-400" placeholder="<%= it.copy.list.searchPlaceholder %>" aria-label="<%= it.copy.search.ariaLabel %>" />
      </div>
      <button class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-white text-neutral-700 shadow-sm ring-1 ring-neutral-200/70 active:scale-95 transition" aria-label="<%= it.copy.a11y.filter %>"><i data-lucide="sliders-horizontal" class="text-lg"></i></button>
    </div>
  </header>
  <main class="px-page pt-4 space-y-4">
    <section aria-label="<%= it.copy.list.sortAriaLabel %>" class="flex gap-2 overflow-x-auto scrollbar-hide -mx-page px-page pb-1">
      <% const _sorts = it.copy.list.sortChips || []; %>
      <% for (const _s of _sorts) { %>
        <button aria-pressed="<%= _s === _sorts[0] ? 'true' : 'false' %>" class="shrink-0 whitespace-nowrap rounded-full px-3.5 py-2 text-xs font-medium transition <%= _s === _sorts[0] ? 'bg-brand-600 text-white shadow-sm' : 'bg-white text-neutral-600 ring-1 ring-neutral-200/70' %>"><%= _s %></button>
      <% } %>
    </section>
    <section class="space-y-3" aria-label="<%= it.copy.list.ariaLabel %>">
      <% const _items = (it.images||[]).slice(0, 8); %>
      <% for (let _i = 0; _i < _items.length; _i++) { %>
        <% const _src = _items[_i]; %>
        <a href="<%= it.link('detail','list','home') %>" class="card flex gap-3 p-3 active:scale-95 transition">
          <img src="<%= _src %>" alt="<%= it.copy.list.cards.imgAlt %>" loading="lazy" class="h-24 w-24 shrink-0 rounded-xl object-cover" onerror="this.onerror=null;this.src='<%= it.placeholder %>'" />
          <div class="flex-1 min-w-0 py-0.5">
            <h3 class="item-title line-clamp-1"><%= it.copy.list.cards.name(_i) %></h3>
            <p class="meta mt-1"><%= it.copy.list.cards.meta %></p>
            <% const _p = it.copy.list.cards.price(_i); const _k = it.copy.list.cards.strike(_i); %>
            <% if (_p || _k) { %>
            <div class="mt-2.5 flex items-baseline gap-2">
              <span class="price text-brand-600"><%= _p %></span>
              <span class="meta text-neutral-400 line-through"><%= _k %></span>
            </div>
            <% } %>
          </div>
        </a>
      <% } %>
    </section>
    <div class="flex items-center justify-center gap-2 py-6 text-sm text-neutral-400"><i data-lucide="loader-circle" class="text-base"></i><%= it.copy.list.loadMore %></div>
  </main>
</div>