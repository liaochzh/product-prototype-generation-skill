<div class="min-h-full bg-neutral-50 pb-28">
  <% /* 复合页（平板范式「列表 + 详情同屏」）：单栏时只显示左列表，点击进入 detail 页；
       双栏时右详情同屏。**内容只写一份**，断点只切 pane 容器显隐（E6：布局切换不改元素树）。 */ %>
  <header class="sticky top-0 z-10 px-page pt-14 pb-3 bg-neutral-50/80 backdrop-blur-xl">
    <p class="eyebrow text-brand-600"><%= it.meta.productName %></p>
    <h2 class="page-title mt-1 text-neutral-900"><%= it.copy.list.title %></h2>
    <div class="mt-3 flex gap-2">
      <div class="flex flex-1 items-center gap-2 rounded-2xl bg-white px-3.5 h-11 shadow-sm ring-1 ring-neutral-200/70">
        <i data-lucide="search" class="text-neutral-400 text-lg"></i>
        <input class="flex-1 bg-transparent text-sm outline-none placeholder:text-neutral-400" placeholder="<%= it.copy.list.searchPlaceholder %>" aria-label="<%= it.copy.search.ariaLabel %>" />
      </div>
      <button class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-white text-neutral-700 shadow-sm ring-1 ring-neutral-200/70 active:scale-95 transition" aria-label="<%= it.copy.a11y.filter %>"><i data-lucide="sliders-horizontal" class="text-lg"></i></button>
    </div>
  </header>

  <main class="px-page pt-4 pb-32 space-y-4 tbl:grid tbl:grid-cols-2 tbl:items-start tbl:gap-6 tbl:space-y-0 tbl:max-w-6xl tbl:mx-auto">
    <section data-pane="list" class="space-y-3" aria-label="<%= it.copy.list.ariaLabel %>">
      <% const _items = (it.images || []).slice(0, 4); %>
      <% for (let _i = 0; _i < _items.length; _i++) { %>
        <% const _src = _items[_i]; %>
        <a href="<%= it.link('detail','list','home') %>" class="card flex gap-3 p-3 active:scale-95 transition">
          <img src="<%= _src %>" alt="<%= it.copy.list.cards.imgAlt %>" loading="lazy" class="h-20 w-20 shrink-0 rounded-xl object-cover" onerror="this.onerror=null;this.src='<%= it.placeholder %>'" />
          <div class="flex-1 min-w-0 py-0.5">
            <h3 class="item-title line-clamp-1"><%= it.copy.list.cards.name(_i) %></h3>
            <p class="meta mt-1"><%= it.copy.list.cards.meta %></p>
            <% const _p = it.copy.list.cards.price(_i); const _k = it.copy.list.cards.strike(_i); %>
            <% if (_p || _k) { %>
            <div class="mt-2 flex items-baseline gap-2">
              <span class="price text-brand-600"><%= _p %></span>
              <span class="meta text-neutral-400 line-through"><%= _k %></span>
            </div>
            <% } %>
          </div>
        </a>
      <% } %>
      <div class="flex items-center justify-center gap-2 py-4 text-sm text-neutral-400"><i data-lucide="loader-circle" class="text-base"></i><%= it.copy.list.loadMore %></div>
    </section>

    <section data-pane="detail" class="hidden space-y-4 tbl:block" aria-label="<%= it.copy.detail.title %>">
      <div class="relative h-64 overflow-hidden rounded-2xl">
        <img src="<%= (it.images || [])[0] || it.placeholder %>" alt="<%= it.copy.detail.imageAlt(0) %>" loading="lazy" class="h-full w-full object-cover" onerror="this.onerror=null;this.src='<%= it.placeholder %>'" />
      </div>
      <div class="space-y-2.5">
        <h2 class="hero-title text-neutral-900"><%= it.copy.detail.heading %></h2>
        <div class="flex items-center gap-2 meta text-neutral-500">
          <span class="badge bg-emerald-50 text-emerald-700"><%= it.copy.detail.badge %></span>
          <% for (const _ml of (it.copy.detail.metaLines || [])) { %><span class="text-neutral-300">·</span><span><%= _ml %></span><% } %>
        </div>
        <% if (it.copy.detail.price && it.copy.detail.price.value) { %>
        <div class="flex items-baseline gap-2.5">
          <span class="price-hero text-brand-600"><%= it.copy.detail.price.value %></span>
          <span class="meta text-neutral-400 line-through"><%= it.copy.detail.price.strike %></span>
          <span class="badge bg-rose-50 text-rose-600"><%= it.copy.detail.price.tag %></span>
        </div>
        <% } %>
      </div>
      <div class="card p-4 space-y-3">
        <h3 class="section-title"><%= it.copy.detail.descTitle %></h3>
        <p class="text-sm leading-relaxed text-neutral-600"><%= it.copy.detail.descText %></p>
      </div>
      <div class="card p-4">
        <div class="flex items-center gap-3">
          <img src="<%= (it.images || [])[1] || it.placeholder %>" alt="<%= it.copy.detail.owner.avatarAlt %>" class="h-12 w-12 rounded-full object-cover ring-2 ring-white shadow-sm" onerror="this.onerror=null;this.src='<%= it.placeholder %>'" />
          <div class="flex-1">
            <p class="item-title"><%= it.copy.detail.owner.name %></p>
            <p class="meta"><%= it.copy.detail.owner.meta %></p>
          </div>
          <a href="<%= it.link('chat','home') %>" class="btn btn-outline px-4 py-2 active:scale-95"><%= it.copy.detail.owner.cta %></a>
        </div>
      </div>
      <div class="flex gap-3" role="toolbar" aria-label="<%= it.copy.detail.ariaLabel.bottomBar %>">
        <% for (const _a of (it.copy.detail.actions || [])) { %>
          <% const _cls = _a.tone === 'secondary' ? 'btn-secondary' : _a.tone === 'outline' ? 'btn-outline' : 'btn-primary'; %>
          <% if (_a.target) { %>
            <a href="<%= it.link(_a.target,'home') %>" class="btn <%= _cls %> flex-1 py-3 active:scale-95"><i data-lucide="<%= _a.icon %>" class="mr-2"></i><%= _a.label %></a>
          <% } else { %>
            <button class="btn <%= _cls %> flex-1 py-3 active:scale-95"><i data-lucide="<%= _a.icon %>" class="mr-2"></i><%= _a.label %></button>
          <% } %>
        <% } %>
      </div>
    </section>
  </main>
</div>
