<div class="min-h-full bg-neutral-50 pb-28">
  <header class="sticky top-0 z-10 px-5 pt-14 pb-3 bg-neutral-50/80 backdrop-blur-xl">
    <a href="<%= it.link('list','home') %>" class="absolute left-4 top-[62px] grid h-10 w-10 place-items-center rounded-full bg-white text-neutral-700 shadow-sm ring-1 ring-neutral-200/70 active:scale-95 transition" aria-label="<%= it.copy.a11y.back %>"><i data-lucide="chevron-left" class="text-lg"></i></a>
    <h2 class="nav-title text-center"><%= it.copy.detail.title %></h2>
    <button class="absolute right-4 top-[62px] grid h-10 w-10 place-items-center rounded-full bg-white text-neutral-700 shadow-sm ring-1 ring-neutral-200/70 active:scale-95 transition" aria-label="<%= it.copy.a11y.more %>"><i data-lucide="ellipsis" class="text-lg"></i></button>
  </header>
  <main class="px-4 pt-4 pb-32 space-y-4">
    <section aria-label="<%= it.copy.detail.ariaLabel.gallery %>" class="relative h-72 overflow-hidden rounded-2xl">
      <% const _imgs = (it.images||[]).slice(0, 3); %>
      <% for (let _i = 0; _i < _imgs.length; _i++) { %>
        <% const _src = _imgs[_i]; %>
        <img src="<%= _src %>" alt="<%= it.copy.detail.imageAlt(_i) %>" loading="lazy" class="absolute inset-0 h-full w-full object-cover <%= _i===0 ? '' : 'hidden' %>" onerror="this.onerror=null;this.src='<%= it.placeholder %>'" />
      <% } %>
      <div class="absolute bottom-3 right-3 flex gap-1.5" aria-label="<%= it.copy.detail.ariaLabel.indicators %>">
        <% for (let _i = 0; _i < _imgs.length; _i++) { %>
          <span class="h-1.5 rounded-full transition-all <%= _i===0 ? 'w-4 bg-white' : 'w-1.5 bg-white/60' %>"></span>
        <% } %>
      </div>
    </section>
    <section class="space-y-2.5">
      <h1 class="hero-title text-neutral-900"><%= it.copy.detail.heading %></h1>
      <div class="flex items-center gap-2 meta text-neutral-500">
        <span class="badge bg-emerald-50 text-emerald-700"><%= it.copy.detail.badge %></span>
        <% for (const _ml of (it.copy.detail.metaLines || [])) { %><span class="text-neutral-300">·</span><span><%= _ml %></span><% } %>
      </div>
      <% if (it.copy.detail.price && it.copy.detail.price.value) { %>
      <div class="flex items-baseline gap-2.5">
        <span class="price-hero text-brand-600"><%= it.copy.detail.price.value %></span>
        <span class="meta text-neutral-400 line-through"><%= it.copy.detail.price.strike %></span>
        <span class="badge bg-rose-50 text-rose-600"><%= it.copy.detail.price.tag %></span>
      </div>
      <% } %>
    </section>
    <section class="card p-4 space-y-3">
      <h3 class="section-title"><%= it.copy.detail.descTitle %></h3>
      <p class="text-sm leading-relaxed text-neutral-600"><%= it.copy.detail.descText %></p>
      <div class="grid grid-cols-3 gap-3 border-t border-neutral-200 pt-3 text-center">
        <% for (const _s of (it.copy.detail.stats || [])) { %>
          <div><p class="stat-value text-neutral-900"><%= _s.value %></p><p class="meta"><%= _s.label %></p></div>
        <% } %>
      </div>
    </section>
    <section class="card p-4 space-y-3">
      <h3 class="section-title"><%= it.copy.detail.owner.title %></h3>
      <div class="flex items-center gap-3">
        <img src="<%= (it.images||[])[0] || it.placeholder %>" alt="<%= it.copy.detail.owner.avatarAlt %>" class="h-12 w-12 rounded-full object-cover ring-2 ring-white shadow-sm" onerror="this.onerror=null;this.src='<%= it.placeholder %>'" />
        <div class="flex-1">
          <p class="item-title"><%= it.copy.detail.owner.name %></p>
          <p class="meta"><%= it.copy.detail.owner.meta %></p>
        </div>
        <a href="<%= it.link('chat','home') %>" class="btn btn-outline px-4 py-2 active:scale-95"><%= it.copy.detail.owner.cta %></a>
      </div>
    </section>
    <section class="space-y-3">
      <h3 class="section-title px-1"><%= it.copy.detail.related.title %></h3>
      <div class="grid grid-cols-2 gap-3">
        <% for (let _i = 0; _i < 4; _i++) { %>
          <a href="<%= it.link('detail','list','home') %>" class="card overflow-hidden p-2 active:scale-95 transition">
            <img src="<%= (it.images||[])[_i % (it.images||[]).length] || it.placeholder %>" alt="<%= it.copy.detail.related.imgAlt %>" loading="lazy" class="h-28 w-full rounded-xl object-cover" onerror="this.onerror=null;this.src='<%= it.placeholder %>'" />
            <p class="item-title mt-2 line-clamp-1"><%= it.copy.detail.related.name(_i) %></p>
            <% if (it.copy.detail.related.price(_i)) { %><p class="price mt-0.5 text-brand-600"><%= it.copy.detail.related.price(_i) %></p><% } %>
          </a>
        <% } %>
      </div>
    </section>
  </main>
  <div class="fixed inset-x-0 bottom-0 z-20 flex gap-3 border-t border-neutral-200 bg-white/95 p-4 backdrop-blur-xl" role="toolbar" aria-label="<%= it.copy.detail.ariaLabel.bottomBar %>">
    <% for (const _a of (it.copy.detail.actions || [])) { %>
      <% const _cls = _a.tone === 'secondary' ? 'btn-secondary' : _a.tone === 'outline' ? 'btn-outline' : 'btn-primary'; %>
      <% if (_a.target) { %>
        <a href="<%= it.link(_a.target,'home') %>" class="btn <%= _cls %> flex-1 py-3 active:scale-95"><i data-lucide="<%= _a.icon %>" class="mr-2"></i><%= _a.label %></a>
      <% } else { %>
        <button class="btn <%= _cls %> flex-1 py-3 active:scale-95"><i data-lucide="<%= _a.icon %>" class="mr-2"></i><%= _a.label %></button>
      <% } %>
    <% } %>
  </div>
</div>