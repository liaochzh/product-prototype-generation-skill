<div class="min-h-full bg-neutral-50 pb-28">
  <header class="sticky top-0 z-10 px-5 pt-14 pb-3 bg-neutral-50/80 backdrop-blur-xl">
    <div class="flex items-center justify-between">
      <div>
        <p class="eyebrow text-brand-600"><%= it.meta.productName %></p>
        <h2 class="page-title mt-1 text-neutral-900"><%= it.copy.home.heading %></h2>
      </div>
      <button class="grid h-10 w-10 place-items-center rounded-full bg-white text-neutral-700 shadow-sm ring-1 ring-neutral-200/70 active:scale-95 transition" aria-label="<%= it.copy.a11y.notify %>"><i data-lucide="bell" class="text-lg"></i></button>
    </div>
    <div class="mt-4 flex items-center gap-2.5 rounded-2xl bg-white px-4 h-11 shadow-sm ring-1 ring-neutral-200/70">
      <i data-lucide="search" class="text-neutral-400 text-lg"></i>
      <input class="flex-1 bg-transparent text-sm outline-none placeholder:text-neutral-400" placeholder="<%= it.copy.search.placeholder %>" aria-label="<%= it.copy.search.ariaLabel %>" />
      <span class="text-xs font-semibold text-brand-600"><%= it.copy.home.searchBtn %></span>
    </div>
  </header>

  <main class="px-4 pt-4 space-y-6">
    <% const _imgs = (it.images || []); const _hero = _imgs[0]; %>
    <% if (_hero) { %>
    <a href="<%= it.link('detail','list','home') %>" class="group relative block overflow-hidden rounded-3xl shadow-lg shadow-neutral-900/10" aria-label="<%= it.copy.home.hero.ariaLabel %>">
      <img src="<%= _hero %>" alt="<%= it.copy.home.hero.imgAlt %>" class="h-60 w-full object-cover transition duration-500 group-hover:scale-105" loading="lazy" onerror="this.onerror=null;this.src='<%= it.placeholder %>'" />
      <div class="absolute inset-0 hero-overlay"></div>
      <div class="absolute inset-x-0 bottom-0 p-5 text-white">
        <span class="inline-flex items-center gap-1 rounded-full bg-white/15 px-2.5 py-1 text-micro font-medium backdrop-blur-md ring-1 ring-white/25"><i data-lucide="sparkles" class="text-micro"></i><%= it.copy.home.hero.badge %></span>
        <h3 class="hero-title mt-2"><%= it.copy.home.hero.title %></h3>
        <p class="mt-1 text-sm text-white/80 line-clamp-1"><%= it.copy.home.hero.desc %></p>
      </div>
    </a>
    <% } %>

    <section aria-label="<%= it.copy.home.quick.ariaLabel %>">
      <div class="mb-3 flex items-baseline justify-between">
        <h3 class="section-title"><%= it.copy.home.quick.title %></h3>
        <a href="<%= it.link('list','home') %>" class="inline-flex items-center gap-0.5 text-xs font-medium text-brand-600"><%= it.copy.home.quick.more %> <i data-lucide="chevron-right" class="text-xs"></i></a>
      </div>
      <div class="grid grid-cols-4 gap-2">
        <% const _quick = (it.copy.home.quick.items || []).map((q) => [q.target, q.label, q.icon]); %>
        <% for (const _q of _quick) { %>
          <a href="<%= it.link(_q[0],'home') %>" class="flex flex-col items-center gap-2 rounded-2xl bg-white p-3 shadow-sm ring-1 ring-neutral-200/60 active:scale-95 transition">
            <span class="grid h-9 w-9 place-items-center rounded-xl bg-brand-50 text-brand-600"><i data-lucide="<%= _q[2] %>" class="text-lg"></i></span>
            <span class="text-xs font-medium text-neutral-600"><%= _q[1] %></span>
          </a>
        <% } %>
      </div>
    </section>

    <% const _recs = _imgs.slice(1, 5); %>
    <% if (_recs.length) { %>
    <section aria-label="<%= it.copy.home.recommend.ariaLabel %>">
      <div class="mb-3 flex items-baseline justify-between">
        <h3 class="section-title"><%= it.copy.home.recommend.title %></h3>
        <a href="<%= it.link('discover','home') %>" class="inline-flex items-center gap-0.5 text-xs font-medium text-brand-600"><%= it.copy.home.recommend.more %> <i data-lucide="chevron-right" class="text-xs"></i></a>
      </div>
      <div class="flex gap-3 overflow-x-auto scrollbar-hide -mx-4 px-4 pb-1">
        <% for (let _i = 0; _i < _recs.length; _i++) { const _r = _recs[_i]; %>
          <a href="<%= it.link('detail','list','home') %>" class="w-40 shrink-0 overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-neutral-200/60 active:scale-95 transition">
            <img src="<%= _r %>" alt="<%= it.copy.home.recommend.imgAlt %>" class="h-28 w-full object-cover" loading="lazy" onerror="this.onerror=null;this.src='<%= it.placeholder %>'" />
            <div class="p-3">
              <h4 class="item-title line-clamp-1"><%= it.copy.home.recommend.cardName(_i) %></h4>
              <% const _cs = it.copy.home.recommend.cardSecondary(_i); %>
              <% if (_cs) { %><p class="meta mt-1"><%= _cs %></p><% } %>
            </div>
          </a>
        <% } %>
      </div>
    </section>
    <% } %>
  </main>

</div>