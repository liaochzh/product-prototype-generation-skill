<div class="min-h-full bg-neutral-50">
  <header class="sticky top-0 z-10 px-page pt-14 pb-3 bg-neutral-50/80 backdrop-blur-xl">
    <a href="<%= it.link('home','list','discover','profile') %>" class="absolute left-4 top-[62px] grid h-10 w-10 place-items-center rounded-full bg-white text-neutral-700 shadow-sm ring-1 ring-neutral-200/70 active:scale-95 transition" aria-label="<%= it.copy.a11y.back %>"><i data-lucide="chevron-left" class="text-lg"></i></a>
    <div class="flex flex-col items-center">
      <span class="nav-title"><%= it.copy.chat.peerName %></span>
      <span class="inline-flex items-center gap-1 meta text-emerald-600"><span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span><%= it.copy.chat.peerState %></span>
    </div>
    <button class="absolute right-4 top-[62px] grid h-10 w-10 place-items-center rounded-full bg-white text-neutral-700 shadow-sm ring-1 ring-neutral-200/70 active:scale-95 transition" aria-label="<%= it.copy.a11y.more %>"><i data-lucide="ellipsis" class="text-lg"></i></button>
  </header>
  <main class="px-page pt-4 pb-20 space-y-4" id="chat-list" role="log" aria-live="polite">
    <% const _msgs = (it.copy.chat.messages || []).map((m) => ({ in: m.side !== 'out', text: m.text, time: m.time })); %>
    <% for (let _mi = 0; _mi < _msgs.length; _mi++) { const _m = _msgs[_mi]; %>
      <div class="flex <%= _m.in ? '' : 'flex-row-reverse' %> gap-2">
        <img src="<%= it.pick(_mi) %>" alt="<%= _m.in ? it.copy.chat.peerRole : it.copy.chat.selfRole %>" class="h-8 w-8 shrink-0 rounded-full object-cover ring-2 ring-white shadow-sm" onerror="this.onerror=null;this.src='<%= it.placeholder %>'" />
        <div class="max-w-[70%]">
          <p class="mb-1 meta text-neutral-400 <%= _m.in ? 'text-left' : 'text-right' %>"><%= _m.time %></p>
          <div class="<%= _m.in ? 'bg-white text-neutral-800 ring-1 ring-neutral-200/70 rounded-tl-none' : 'bg-brand-600 text-white rounded-tr-none' %> rounded-2xl px-4 py-2.5 shadow-sm">
            <p class="text-sm leading-relaxed"><%= _m.text %></p>
          </div>
        </div>
      </div>
    <% } %>
    <div class="h-8" id="scroll-anchor"></div>
  </main>
  <div class="fixed inset-x-0 bottom-0 z-20 flex items-center gap-2 border-t border-neutral-200 bg-white/95 p-3 backdrop-blur-xl" role="toolbar">
    <button class="grid h-10 w-10 shrink-0 place-items-center rounded-full text-neutral-500 transition hover:bg-neutral-100 active:scale-95" aria-label="<%= it.copy.chat.ariaLabel.addImage %>"><i data-lucide="image" class="text-lg"></i></button>
    <input class="input flex-1" placeholder="<%= it.copy.chat.inputPlaceholder %>" aria-label="<%= it.copy.chat.ariaLabel.inputMessage %>" />
    <button class="btn btn-primary h-10 w-10 shrink-0 !px-0 active:scale-95" aria-label="<%= it.copy.chat.ariaLabel.send %>"><i data-lucide="send" class="text-base"></i></button>
  </div>
</div>