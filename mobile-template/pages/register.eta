<div class="min-h-full bg-neutral-50 pb-10">
  <% const _rg = it.copy.register; %>
  <header class="px-5 pt-14 pb-6">
    <div class="flex items-center justify-between">
      <%~ it.brandMark %>
      <a href="<%= it.link(_rg.skip.target, _rg.skip.fallback) %>" class="grid h-10 w-10 place-items-center rounded-full bg-white text-neutral-600 shadow-sm ring-1 ring-neutral-200/70 active:scale-95 transition" aria-label="<%= _rg.skip.label %>"><i data-lucide="x" class="text-lg"></i></a>
    </div>
    <h2 class="page-title mt-6 text-neutral-900"><%= _rg.title %></h2>
    <p class="mt-1.5 text-sm text-neutral-500"><%= _rg.subtitle %></p>
  </header>
  <main class="px-4 space-y-4">
    <section class="card p-5" aria-label="<%= _rg.cardAriaLabel %>">
      <div class="space-y-4">
        <% for (const _f of (_rg.fields || [])) { %>
          <div>
            <label for="<%= _f.id %>" class="label mb-1.5 block text-neutral-600"><%= _f.label %><% if (_f.required) { %> <span class="text-rose-500" aria-hidden="true">*</span><% } %></label>
            <div class="flex gap-2">
              <input id="<%= _f.id %>" type="<%= _f.kind === 'password' ? 'password' : 'text' %>" autocomplete="<%= _f.autocomplete %>" class="input min-w-0 flex-1" placeholder="<%= _f.placeholder %>"<% if (_f.required) { %> required aria-required="true"<% } %> />
              <% if (_f.sendCode) { %>
                <button type="button" data-send-code data-countdown="<%= _rg.codeButton.seconds %>" data-idle="<%= _rg.codeButton.idle %>" data-counting="<%= _rg.codeButton.counting %>" data-status-sent="<%= _rg.codeButton.statusSent %>" data-status-ready="<%= _rg.codeButton.statusReady %>" class="btn btn-outline shrink-0 px-3 py-2 active:scale-95" aria-label="<%= _rg.codeButton.ariaLabel %>"><%= _rg.codeButton.idle %></button>
                <p role="status" aria-live="polite" aria-atomic="true" class="sr-only" data-code-status></p>
              <% } %>
            </div>
          </div>
        <% } %>
        <label class="flex items-start gap-2 text-sm text-neutral-600"><input id="<%= _rg.agree.id %>" type="checkbox" class="mt-0.5 h-4 w-4 shrink-0 rounded text-brand-600"<%= _rg.agree.checked ? ' checked' : '' %> /><span><%= _rg.agree.prefix %><% for (const _l of (_rg.agree.links || [])) { %><a href="<%= _l.href %>" class="text-brand-600 transition active:opacity-70"><%= _l.text %></a><% } %></span></label>
        <button class="btn btn-primary w-full py-3 active:scale-95"><%= _rg.submit %></button>
      </div>
    </section>
    <p class="text-center text-sm text-neutral-500"><%= _rg.toLogin.label %> <a href="<%= it.link(_rg.toLogin.target) %>" class="font-medium text-brand-600 transition active:opacity-70"><%= _rg.toLogin.action %></a></p>
    <a href="<%= it.link(_rg.skip.target, _rg.skip.fallback) %>" class="btn btn-ghost w-full py-2.5"><i data-lucide="arrow-right" class="text-base"></i><%= _rg.skip.label %></a>
  </main>
  <script>
    (function () {
      var toArr = function (n) { return Array.prototype.slice.call(n); };
      // a11y（WCAG 4.1.3 状态消息）：按钮文案每秒都在变，**不能**把 live region 放在按钮上（会每秒播报）；
      // 故只在「开始倒计时 / 倒计时结束」两次写入旁侧的 role="status" 节点（可见文案仍逐秒更新）。
      toArr(document.querySelectorAll('[data-send-code]')).forEach(function (b) {
        var timer = null;
        var row = b.parentElement;
        var status = row ? row.querySelector('[data-code-status]') : null;
        var say = function (tpl, n) {
          if (status && tpl) { status.textContent = tpl.replace('{{s}}', String(n)); }
        };
        b.addEventListener('click', function () {
          if (timer) { return; }
          var left = Number(b.getAttribute('data-countdown')) || 60;
          var counting = b.getAttribute('data-counting');
          b.disabled = true;
          b.classList.add('opacity-60');
          b.textContent = counting + '（' + left + 's）';
          say(b.getAttribute('data-status-sent'), left);
          timer = setInterval(function () {
            left -= 1;
            if (left <= 0) {
              clearInterval(timer); timer = null;
              b.disabled = false; b.classList.remove('opacity-60');
              b.textContent = b.getAttribute('data-idle');
              say(b.getAttribute('data-status-ready'), 0);
              return;
            }
            b.textContent = counting + '（' + left + 's）';
          }, 1000);
        });
      });
    })();
  </script>
</div>
