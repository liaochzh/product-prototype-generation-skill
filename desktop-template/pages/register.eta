<div class="mx-auto max-w-4xl">
  <% const _rg = it.copy.register; const _rd = _rg.desktop; %>
  <section class="card overflow-hidden" aria-label="<%= _rg.ariaLabel %>">
    <div class="grid grid-cols-1 md:grid-cols-2">
      <aside class="hidden md:flex flex-col justify-between gap-8 bg-brand-50/40 p-8 border-r border-neutral-200" aria-label="<%= _rd.asideAriaLabel %>">
        <div>
          <p class="eyebrow text-brand-600"><%= _rd.asideEyebrow %></p>
          <h3 class="hero-title mt-2 text-neutral-900"><%= _rd.asideTitle %></h3>
          <p class="mt-2 text-sm text-neutral-600"><%= _rd.asideDesc %></p>
        </div>
        <ul class="space-y-3">
          <% for (const _h of (_rd.highlights || [])) { %>
            <li class="flex items-center gap-2.5 text-sm text-neutral-700"><span class="grid h-8 w-8 shrink-0 place-items-center rounded-xl bg-white text-brand-600 ring-1 ring-neutral-200/70"><i data-lucide="<%= _h.icon %>" class="text-base"></i></span><%= _h.text %></li>
          <% } %>
        </ul>
      </aside>
      <div class="p-8">
        <h3 class="section-title"><%= _rg.title %></h3>
        <p class="meta mt-1 text-neutral-500"><%= _rg.subtitle %></p>
        <div class="mt-6 space-y-4">
          <% for (const _f of (_rg.fields || [])) { %>
            <div>
              <label for="<%= _f.id %>" class="label mb-1.5 block text-neutral-600"><%= _f.label %><% if (_f.required) { %> <span class="text-rose-500" aria-hidden="true">*</span><% } %></label>
              <div class="flex gap-2">
                <input id="<%= _f.id %>" type="<%= _f.kind === 'password' ? 'password' : 'text' %>" autocomplete="<%= _f.autocomplete %>" class="input min-w-0 flex-1" placeholder="<%= _f.placeholder %>"<% if (_f.required) { %> required aria-required="true"<% } %> />
                <% if (_f.sendCode) { %>
                  <button type="button" data-send-code data-countdown="<%= _rg.codeButton.seconds %>" data-idle="<%= _rg.codeButton.idle %>" data-counting="<%= _rg.codeButton.counting %>" data-status-sent="<%= _rg.codeButton.statusSent %>" data-status-ready="<%= _rg.codeButton.statusReady %>" class="btn btn-outline shrink-0 px-3 py-2" aria-label="<%= _rg.codeButton.ariaLabel %>"><%= _rg.codeButton.idle %></button>
                  <p role="status" aria-live="polite" aria-atomic="true" class="sr-only" data-code-status></p>
                <% } %>
              </div>
            </div>
          <% } %>
          <label class="flex items-start gap-2 text-sm text-neutral-600"><input id="<%= _rg.agree.id %>" type="checkbox" class="mt-0.5 h-4 w-4 shrink-0 rounded text-brand-600"<%= _rg.agree.checked ? ' checked' : '' %> /><span><%= _rg.agree.prefix %><% for (const _l of (_rg.agree.links || [])) { %><a href="<%= _l.href %>" class="text-brand-600 transition hover:text-brand-700"><%= _l.text %></a><% } %></span></label>
          <button class="btn btn-primary w-full py-2.5"><%= _rg.submit %></button>
        </div>
        <p class="mt-5 text-center text-sm text-neutral-500"><%= _rg.toLogin.label %> <a href="<%= it.link(_rg.toLogin.target) %>" class="font-medium text-brand-600 transition hover:text-brand-700"><%= _rg.toLogin.action %></a></p>
      </div>
    </div>
  </section>
  <div class="mt-4 text-center">
    <a href="<%= it.link(_rg.skip.target, _rg.skip.fallback) %>" class="btn btn-ghost px-4 py-2"><i data-lucide="arrow-right" class="text-base"></i><%= _rg.skip.label %></a>
  </div>
  <script>
    (function () {
      var toArr = function (n) { return Array.prototype.slice.call(n); };
      // a11y（WCAG 4.1.3 状态消息）：按钮文案每秒都在变，**不能**把 live region 放在按钮上（会每秒播报）；
      // 故只在「开始倒计时 / 倒计时结束」两次写入旁侧的 role="status" 节点（可见文案仍逐秒更新）。
      toArr(document.querySelectorAll('[data-send-code]')).forEach(function (b) {
        var timer = null;
        var row = b.parentElement;
        var status = row ? row.querySelector('[data-code-status]') : null;
        var say = function (tpl, n) {
          if (status && tpl) { status.textContent = tpl.replace('{{s}}', String(n)); }
        };
        b.addEventListener('click', function () {
          if (timer) { return; }
          var left = Number(b.getAttribute('data-countdown')) || 60;
          var counting = b.getAttribute('data-counting');
          b.disabled = true;
          b.classList.add('opacity-60');
          b.textContent = counting + '（' + left + 's）';
          say(b.getAttribute('data-status-sent'), left);
          timer = setInterval(function () {
            left -= 1;
            if (left <= 0) {
              clearInterval(timer); timer = null;
              b.disabled = false; b.classList.remove('opacity-60');
              b.textContent = b.getAttribute('data-idle');
              say(b.getAttribute('data-status-ready'), 0);
              return;
            }
            b.textContent = counting + '（' + left + 's）';
          }, 1000);
        });
      });
    })();
  </script>
</div>
