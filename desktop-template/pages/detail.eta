<div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
  <section class="space-y-6 lg:col-span-2">
    <section class="card overflow-hidden" aria-label="<%= it.copy.detail.desktop.gallery %>">
      <img src="<%= (it.images||[])[0] || it.placeholder %>" alt="<%= it.copy.detail.ariaLabel.main %>" class="h-80 w-full object-cover" onerror="this.onerror=null;this.src='<%= it.placeholder %>'" />
      <div class="flex gap-2 overflow-x-auto p-4">
        <% const _imgs = (it.images||[]).slice(0, 5); %>
        <% for (const _src of _imgs) { %>
          <img src="<%= _src %>" alt="<%= it.copy.detail.ariaLabel.thumb %>" class="h-20 w-20 cursor-pointer rounded-xl object-cover ring-2 ring-transparent transition hover:ring-brand-500" onerror="this.onerror=null;this.src='<%= it.placeholder %>'" />
        <% } %>
      </div>
    </section>
    <section class="card space-y-4 p-5">
      <div class="flex items-start justify-between gap-4">
        <div><h1 class="hero-title text-neutral-900"><%= it.copy.detail.desktop.heading %></h1><p class="meta mt-1 text-neutral-500"><%= it.copy.detail.desktop.sub %></p></div>
        <span class="badge bg-emerald-50 px-3 py-1 text-emerald-700"><%= it.copy.detail.badge %></span>
      </div>
      <% /* 非电商类型 price 三值皆空，整行只渲染边框分隔线，需整段跳过（对齐移动端 detail.eta 守卫） */ %>
      <% if (it.copy.detail.price && it.copy.detail.price.value) { %>
      <div class="flex items-baseline gap-4 border-t border-neutral-200 pt-3"><span class="price-hero text-brand-600"><%= it.copy.detail.price.value %></span><span class="text-neutral-400 line-through"><%= it.copy.detail.price.strike %></span><span class="badge bg-rose-50 text-rose-600"><%= it.copy.detail.price.tag %></span></div>
      <% } %>
      <div class="grid grid-cols-3 gap-4 border-t border-neutral-200 pt-3">
        <% for (const _s of (it.copy.detail.desktop.stats || [])) { %>
          <div><p class="meta text-neutral-500"><%= _s.label %></p><p class="stat-value text-neutral-900"><%= _s.value %></p></div>
        <% } %>
      </div>
      <div><h3 class="section-title mb-2"><%= it.copy.detail.descTitle %></h3><p class="whitespace-pre-line leading-relaxed text-neutral-600"><%= it.copy.detail.descText %></p></div>
      <div><h3 class="section-title mb-2"><%= it.copy.detail.owner.title %></h3>
        <div class="flex items-center gap-3 rounded-xl bg-neutral-50 p-3">
          <img src="<%= (it.images||[])[0] || it.placeholder %>" alt="<%= it.copy.detail.desktop.ownerAlt %>" class="h-12 w-12 rounded-full object-cover ring-2 ring-white shadow-sm" onerror="this.onerror=null;this.src='<%= it.placeholder %>'" />
          <div><p class="item-title text-neutral-900"><%= it.copy.detail.owner.name %></p><p class="meta text-neutral-500"><%= it.copy.detail.desktop.ownerMeta %></p></div>
          <button class="btn btn-outline ml-auto px-4"><%= it.copy.detail.desktop.ownerCta %></button>
        </div>
      </div>
    </section>
  </section>
  <aside class="space-y-4">
    <section class="card space-y-4 p-5" aria-label="<%= it.copy.detail.ariaLabel.purchase %>">
      <div class="flex items-center justify-between rounded-xl bg-brand-50 p-3"><div><p class="meta text-brand-700"><%= it.copy.detail.desktop.finalLabel %></p><p class="price-hero text-brand-600"><%= it.copy.detail.desktop.finalValue %></p></div><span class="badge bg-brand-100 text-brand-700"><%= it.copy.detail.desktop.finalBadge %></span></div>
      <% /* 购买区为「2 个通栏 + N 个半栏」固定骨架：按钮样式属布局，非领域文案 */ %>
      <% const _acts = it.copy.detail.desktop.actions || []; %>
      <% for (let _ai = 0; _ai < Math.min(2, _acts.length); _ai++) { const _a = _acts[_ai]; %>
        <button class="btn <%= _a.tone === 'secondary' ? 'btn-secondary' : _a.tone === 'outline' ? 'btn-outline' : 'btn-primary' %> w-full py-3 active:scale-95"><i data-lucide="<%= _a.icon %>" class="mr-2"></i><%= _a.label %></button>
      <% } %>
      <% if (_acts.length > 2) { %>
        <div class="flex gap-2">
          <% for (let _ai = 2; _ai < _acts.length; _ai++) { const _a = _acts[_ai]; %>
            <button class="btn <%= _a.tone === 'secondary' ? 'btn-secondary' : _a.tone === 'outline' ? 'btn-outline' : 'btn-primary' %> flex-1 py-2 active:scale-95"><i data-lucide="<%= _a.icon %>" class="mr-2"></i><%= _a.label %></button>
          <% } %>
        </div>
      <% } %>
      <p class="meta text-center text-neutral-500"><%= it.copy.detail.desktop.guarantee %></p>
    </section>
    <section class="card p-5" aria-label="<%= it.copy.detail.ariaLabel.related %>">
      <h3 class="section-title mb-3"><%= it.copy.detail.related.title %></h3>
      <div class="space-y-2">
        <% const _related = it.copy.detail.desktop.relatedRows || []; for (let _ri = 0; _ri < _related.length; _ri++) { const _r = _related[_ri]; %>
          <a href="<%= it.link('detail','list','home') %>" class="flex gap-3 rounded-xl p-2 transition hover:bg-neutral-50"><img src="<%= it.pick(_ri) %>" alt="" class="h-16 w-16 rounded-lg object-cover ring-1 ring-neutral-200" onerror="this.onerror=null;this.src='<%= it.placeholder %>'" /><div class="min-w-0 flex-1"><p class="item-title text-neutral-800 line-clamp-1"><%= _r.name %></p><p class="price mt-0.5 text-brand-600"><%= _r.value %></p></div></a>
        <% } %>
      </div>
    </section>
  </aside>
</div>