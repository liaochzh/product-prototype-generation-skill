<!DOCTYPE html>
<html lang="zh-CN">
<head><%~ it.head %></head>
<body class="bg-neutral-100 text-neutral-900 antialiased">
<div class="flex min-h-screen max-w-7xl mx-auto">
  <% const _icons = { home:'layout-dashboard', discover:'compass', list:'list', detail:'file-text', publish:'circle-plus', chat:'message-square', orders:'receipt-text', profile:'user-round', dashboard:'layout-dashboard', settings:'settings', form:'pen-line', login:'log-in' }; %>
  <% const _lay = it.copy.layout || {}; %>
  <aside class="hidden md:flex w-64 flex-col bg-white border-r border-neutral-200 p-5 sticky top-0 h-screen" aria-label="<%= _lay.sidebarAriaLabel %>">
    <div class="px-1 py-1"><%~ it.signature %></div>
    <nav class="mt-8 space-y-0.5 flex-1 overflow-y-auto" aria-label="<%= _lay.navAriaLabel %>">
      <% for (const _n of it.nav) { %>
        <% const _on = it.page === _n.name; %>
        <a href="<%= it.link(_n.name) %>" class="group flex items-center gap-3 px-3 py-2 rounded-xl text-sm transition <%= _on ? 'bg-brand-50 text-brand-700 font-semibold' : 'text-neutral-600 hover:bg-neutral-100 hover:text-neutral-900' %>"><i data-lucide="<%= _icons[_n.name] || 'circle' %>" class="text-lg shrink-0"></i><%= _n.title %><% if (_on) { %><span class="ml-auto h-1.5 w-1.5 rounded-full bg-brand-500"></span><% } %></a>
      <% } %>
    </nav>
    <div class="mt-4 flex items-center gap-3 rounded-2xl bg-neutral-50 border border-neutral-200 p-3">
      <span class="grid h-9 w-9 place-items-center rounded-full bg-brand-100 text-brand-700 text-sm font-semibold">U</span>
      <div class="min-w-0 flex-1">
        <p class="text-sm font-medium text-neutral-900 truncate"><%= _lay.userName %></p>
        <p class="text-xs text-neutral-500 truncate"><%= _lay.userPlan %></p>
      </div>
      <i data-lucide="chevrons-up-down" class="text-neutral-400 text-base"></i>
    </div>
  </aside>
  <div class="flex-1 min-w-0">
    <header class="sticky top-0 z-20 bg-white/85 backdrop-blur-xl border-b border-neutral-200 px-8 py-4 flex items-center gap-4">
      <div class="min-w-0">
        <p class="eyebrow text-neutral-400"><%= _lay.previewEyebrow %></p>
        <h2 class="page-title truncate"><%= it.title %></h2>
      </div>
      <div class="ml-auto flex items-center gap-3">
        <div class="relative hidden lg:block">
          <i data-lucide="search" class="absolute left-3 top-1/2 -translate-y-1/2 text-neutral-400 text-base"></i>
          <input class="input pl-9 w-64" placeholder="<%= _lay.searchPlaceholder %>" aria-label="<%= it.copy.search.ariaLabel %>" />
        </div>
        <button class="grid h-9 w-9 place-items-center rounded-full bg-neutral-100 text-neutral-600 hover:bg-neutral-200 transition" aria-label="<%= it.copy.a11y.notify %>"><i data-lucide="bell" class="text-lg"></i></button>
        <button class="btn btn-primary px-4 h-9"><%= _lay.createLabel %></button>
      </div>
    </header>
    <main class="p-8" role="main"><%~ it.pageContent %></main>
  </div>
</div>
</body>
</html>